# Environment Variables for E2E Tests
E2E_LOG_LEVEL=DEBUG

SAASUS_SAAS_ID=<YOUR_SAASUS_SAAS_ID>
SAASUS_API_KEY=<YOUR_SAASUS_API_KEY>
SAASUS_SECRET_KEY=<YOUR_SAASUS_SECRET_KEY>
SAASUS_BASE_URL=https://api.saasus.io/v1

# Cognito settings for acquiring ID/Access tokens used in auth stories
E2E_COGNITO_USER_POOL_ID=<YOUR_COGNITO_USER_POOL_ID>
E2E_COGNITO_CLIENT_ID=<YOUR_COGNITO_APP_CLIENT_ID>
E2E_COGNITO_USERNAME=<YOUR_COGNITO_TEST_USERNAME>
E2E_COGNITO_PASSWORD=<YOUR_COGNITO_TEST_PASSWORD>
E2E_COGNITO_REGION=ap-northeast-1
# E2E_COGNITO_ENDPOINT=http://localhost:8081

# Stripe設定（実際のStripeアカウント用）
STRIPE_SECRET_KEY=<YOUR_STRIPE_SECRET_KEY>

# signupのテストをskipするときはtrue
AUTH_E2E_SKIP_SIGNUP_ON_COGNITO_EMAIL_LIMIT=false
